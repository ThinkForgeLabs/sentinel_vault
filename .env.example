# Copy this file to .env and fill in real values before running the stack.
# scripts/bootstrap.sh does this automatically and generates SECRET_KEY for you.

# ── General ──
APP_NAME=Sentinel Vault
ENVIRONMENT=development
DEBUG=true
# Must be a long random string in any non-development environment.
# Generate one with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-64-char-string

# ── Database ──
# Matches docker-compose.yml's postgres service (host port 5433).
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5433/sentinel_vault
DATABASE_ECHO=false

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── Storage ──
STORAGE_ROOT=./data/recordings
UPLOAD_ROOT=./data/uploads
ENCRYPTION_ENABLED=true
SEGMENT_DURATION_MINUTES=15

# ── CORS ──
# JSON array of allowed origins for the web frontend.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ── Auth ──
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# ── API ──
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
