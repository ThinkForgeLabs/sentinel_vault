# Copy this file to .env and fill in real values before running the stack.
# scripts/bootstrap.sh does this automatically and generates SECRET_KEY for you.

# ── General ──
APP_NAME=Sentinel Vault
ENVIRONMENT=development
DEBUG=true
# Must be a long random string in any non-development environment.
# Generate one with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-64-char-string

# ── Database ──
# Matches docker-compose.yml's postgres service (host port 5433).
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5433/sentinel_vault
DATABASE_ECHO=false

# Used by docker-compose.prod.yml only (Compose interpolates this into the
# api service's DATABASE_URL and the postgres service's own password --
# it is not read directly by the app). Required for `docker compose -f
# docker-compose.prod.yml build|up`; generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-to-a-random-password

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── Storage ──
STORAGE_ROOT=./data/recordings
UPLOAD_ROOT=./data/uploads
MODELS_DIR=./data/models
ENCRYPTION_ENABLED=true
SEGMENT_DURATION_MINUTES=15

# ── MQTT / CoT (optional bridge for TAK Server / ATAK / WinTAK / FreeTAKServer) ──
# Off by default. Turn on per-camera via the detection-settings endpoint
# (mqtt_publish_enabled / cot_publish_enabled) once a broker is configured here.
MQTT_ENABLED=false
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS_ENABLED=false
MQTT_TLS_INSECURE=false
MQTT_TOPIC_ALERTS=sentinelvault/alerts
MQTT_TOPIC_COT=cot
# CoT event type code (TAK affiliation/dimension/type, e.g. "a-u-G" = unknown
# ground) applied to every published detection — see MIL-STD-2525 CoT types.
COT_TYPE=a-u-G
COT_STALE_SECONDS=60

# ── CORS ──
# JSON array of allowed origins for the web frontend.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ── Auth ──
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# ── API ──
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
